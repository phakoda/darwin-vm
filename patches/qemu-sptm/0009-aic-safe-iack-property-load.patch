From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: phakoda <130813466+phakoda@users.noreply.github.com>
Date: Tue, 1 Sep 2026 13:50:00 -0400
Subject: [PATCH] darwin: load AIC IACK offset safely from ADT

ADT properties are only four-byte aligned. Avoid dereferencing the 64-bit
AIC IACK property through a uint64_t pointer; use QEMU's endian-safe unaligned
load helper instead. This keeps the Linux host path portable to architectures
with stricter alignment requirements.
---
 hw/arm/darwin.c | 24 +++++++++++++++++-------
 1 file changed, 17 insertions(+), 7 deletions(-)

diff --git a/hw/arm/darwin.c b/hw/arm/darwin.c
--- a/hw/arm/darwin.c
+++ b/hw/arm/darwin.c
@@ -150,5 +150,18 @@ static bool adt_read_u32_prop(struct dtree_node *node, const char *name,
     *value = ldl_le_p(prop);
     return true;
 }
 
+static bool adt_read_u64_prop(struct dtree_node *node, const char *name,
+                              uint64_t *value)
+{
+    const void *prop = adt_get_prop_val(node, name);
+
+    if (!prop || adt_get_prop_len(node, name) < sizeof(*value)) {
+        return false;
+    }
+
+    *value = ldq_le_p(prop);
+    return true;
+}
+
 static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
@@ -241,17 +254,14 @@ static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
                 event_base = aic_reg[1].base + iobase;
                 event_size = aic_reg[1].len;
             } else {
-                uint64_t *iack_offset =
-                    adt_get_prop_val(aic, "aic-iack-offset");
+                uint64_t iack_offset;
 
-                if (!iack_offset ||
-                    adt_get_prop_len(aic, "aic-iack-offset") <
-                        sizeof(*iack_offset) ||
-                    *iack_offset >= aic_reg[0].len) {
+                if (!adt_read_u64_prop(aic, "aic-iack-offset", &iack_offset) ||
+                    iack_offset >= aic_reg[0].len) {
                     fprintf(stderr,
                             "error: AIC%d has no usable event register\n",
                             aic_vers);
                     exit(1);
                 }
 
-                event_base = aic_reg[0].base + iobase + *iack_offset;
+                event_base = aic_reg[0].base + iobase + iack_offset;
