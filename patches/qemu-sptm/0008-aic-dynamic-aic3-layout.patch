From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: phakoda <130813466+phakoda@users.noreply.github.com>
Date: Tue, 1 Sep 2026 13:40:00 -0400
Subject: [PATCH] aic: honor dynamic AIC3 register layout

AIC3 firmware describes its capability and external-interrupt register offsets
through ADT properties instead of relying on the AIC2 fixed layout. Pass those
offsets into the AIC model so newer Apple device trees can use their native
register geometry. Keep the documented AIC2 defaults and honor its optional
extint-baseaddress override.
---
 hw/arm/apple_aic.c         | 29 ++++++++++++++++++++++++++---
 hw/arm/darwin.c            | 38 ++++++++++++++++++++++++++++++++++++++
 include/hw/arm/apple_aic.h |  3 +++
 3 files changed, 67 insertions(+), 3 deletions(-)

diff --git a/include/hw/arm/apple_aic.h b/include/hw/arm/apple_aic.h
--- a/include/hw/arm/apple_aic.h
+++ b/include/hw/arm/apple_aic.h
@@ -13,8 +13,11 @@ AppleAICState *apple_aic_create(uint32_t version,
                                 uint32_t max_irq,
                                 hwaddr base,
                                 uint64_t base_size,
                                 hwaddr event_base,
                                 uint64_t event_size,
+                                uint32_t cap0_offset,
+                                uint32_t maxnumirq_offset,
+                                uint32_t irq_cfg_base,
                                 qemu_irq cpu_irq);
 
 qemu_irq apple_aic_get_irq(AppleAICState *s, uint32_t irq);
diff --git a/hw/arm/apple_aic.c b/hw/arm/apple_aic.c
--- a/hw/arm/apple_aic.c
+++ b/hw/arm/apple_aic.c
@@ -65,8 +65,10 @@ struct AppleAICState {
     bool separate_event;
     bool embedded_event;
     hwaddr event_offset;
     bool enabled;
 
     uint32_t config;
+    uint32_t cap0_offset;
+    uint32_t maxnumirq_offset;
     uint32_t irq_cfg_base;
     uint32_t sw_set;
@@ -274,12 +276,12 @@ static uint64_t apple_aic_read(void *opaque, hwaddr addr, unsigned size)
         if (addr == AIC2_VERSION) {
             return s->version;
         }
-        if (addr == AIC2_INFO1) {
+        if (addr == s->cap0_offset) {
             return s->nr_irq & 0xffff;
         }
         if (addr == AIC2_INFO2) {
             return 0;
         }
-        if (addr == AIC2_INFO3) {
+        if (addr == s->maxnumirq_offset) {
             return s->max_irq & 0xffff;
         }
@@ -502,4 +504,11 @@ static void apple_aic_realize(DeviceState *dev, Error **errp)
         return;
     }
 
+    if (s->version >= 2 &&
+        ((s->cap0_offset | s->maxnumirq_offset | s->irq_cfg_base) & 3)) {
+        error_setg(errp, "apple-aic: unaligned AIC%u register layout",
+                   s->version);
+        return;
+    }
+
     s->num_words = DIV_ROUND_UP(s->max_irq, 32);
@@ -519,6 +528,5 @@ static void apple_aic_realize(DeviceState *dev, Error **errp)
         s->irq_cfg_base = AIC1_TARGET_CPU;
         s->sw_set = AIC1_TARGET_CPU + AIC1_MAX_IRQ * sizeof(uint32_t);
     } else {
-        s->irq_cfg_base = s->version == 2 ? AIC2_IRQ_CFG : AIC3_IRQ_CFG;
         s->sw_set = s->irq_cfg_base + s->max_irq * sizeof(uint32_t);
     }
@@ -541,4 +549,13 @@ static void apple_aic_realize(DeviceState *dev, Error **errp)
         return;
     }
 
+    if (s->version >= 2 &&
+        (s->cap0_offset > s->base_size - sizeof(uint32_t) ||
+         s->maxnumirq_offset > s->base_size - sizeof(uint32_t))) {
+        error_setg(errp,
+                   "apple-aic: AIC%u capability registers exceed MMIO aperture",
+                   s->version);
+        return;
+    }
+
     if (s->version >= 2 && !s->separate_event && !s->embedded_event) {
@@ -587,5 +604,8 @@ AppleAICState *apple_aic_create(uint32_t version,
                                 uint64_t base_size,
                                 hwaddr event_base,
                                 uint64_t event_size,
+                                uint32_t cap0_offset,
+                                uint32_t maxnumirq_offset,
+                                uint32_t irq_cfg_base,
                                 qemu_irq cpu_irq)
 {
@@ -599,4 +619,7 @@ AppleAICState *apple_aic_create(uint32_t version,
     s->nr_irq = nr_irq;
     s->max_irq = max_irq;
     s->base_size = base_size;
+    s->cap0_offset = cap0_offset;
+    s->maxnumirq_offset = maxnumirq_offset;
+    s->irq_cfg_base = irq_cfg_base;
     s->event_size = event_size;
diff --git a/hw/arm/darwin.c b/hw/arm/darwin.c
--- a/hw/arm/darwin.c
+++ b/hw/arm/darwin.c
@@ -137,5 +137,18 @@ static void init_sep(struct dtree_node *dt_root) {
 
     alloc_zeroed("sep", sep_reg[0].base, sep_reg[0].len);
 }
 
+static bool adt_read_u32_prop(struct dtree_node *node, const char *name,
+                              uint32_t *value)
+{
+    const void *prop = adt_get_prop_val(node, name);
+
+    if (!prop || adt_get_prop_len(node, name) < sizeof(*value)) {
+        return false;
+    }
+
+    *value = ldl_le_p(prop);
+    return true;
+}
+
 static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
@@ -151,5 +164,8 @@ static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
     uint32_t max_irq = 0;
     hwaddr event_base = 0;
     uint64_t event_size = 0;
+    uint32_t cap0_offset = 0;
+    uint32_t maxnumirq_offset = 0;
+    uint32_t irq_cfg_base = 0;
 
     if (!aic) {
@@ -191,4 +207,25 @@ static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
              * per-SoC AIC2/3 capability discovery is available.
              */
             nr_irq = max_irq = A_GOOD_NUMBER_OF_IRQS;
+            if (aic_vers == 2) {
+                cap0_offset = 0x0004;
+                maxnumirq_offset = 0x000c;
+                irq_cfg_base = 0x2000;
+
+                if (adt_get_prop_val(aic, "extint-baseaddress") &&
+                    !adt_read_u32_prop(aic, "extint-baseaddress",
+                                       &irq_cfg_base)) {
+                    fprintf(stderr,
+                            "error: AIC2 has invalid extint-baseaddress\n");
+                    exit(1);
+                }
+            } else if (!adt_read_u32_prop(aic, "cap0-offset", &cap0_offset) ||
+                       !adt_read_u32_prop(aic, "maxnumirq-offset",
+                                          &maxnumirq_offset) ||
+                       !adt_read_u32_prop(aic, "extint-baseaddress",
+                                          &irq_cfg_base)) {
+                fprintf(stderr, "error: AIC3 is missing dynamic layout data\n");
+                exit(1);
+            }
+
             if (reg_count >= 2) {
@@ -231,5 +266,6 @@ static AppleAICState *init_aic(struct dtree_node *dt_root, uint64_t iobase,
     return apple_aic_create(aic_vers, nr_irq, max_irq,
                             aic_reg[0].base + iobase, aic_reg[0].len,
                             event_base, event_size,
+                            cap0_offset, maxnumirq_offset, irq_cfg_base,
                             qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
 }
-- 
